@inherits LayoutComponentBase

@inject Ptlk.SSO.Client.PtlkServiceAuthenticationOptions Authentication
@inject Ptlk.SSO.Client.PtlkSsoServiceOptions Sso
@inject Ptlk.SSO.Core.Security.PtlkSecurityWarningOptions SecurityWarnings

@if (SecurityWarnings.Show && Authentication.IsDevelopmentBypass)
{
    <div role="alert" style="background:#b45309;color:white;padding:.5rem 1rem;font-weight:700">Development Bypass — synthetic identity active</div>
}
@if (SecurityWarnings.Show && !Sso.RequireTls)
{
    <div role="alert" style="background:#b91c1c;color:white;padding:.5rem 1rem;font-weight:700">TLS NOT REQUIRED — controlled test networks only</div>
}

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main">
        <div class="topbar">
            <span>AlarmLogger</span>
            <span class="muted">v1.0</span>
            <UserSessionMenu />
        </div>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
